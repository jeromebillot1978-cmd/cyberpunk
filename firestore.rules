rules_version = '2';

// =========================================================
// RÈGLES FIRESTORE — Sun Pilot · Neon Skies
// ---------------------------------------------------------
// users/{uid}        profil du pilote : { uid, pseudo, createdAt, updatedAt }
// pseudos/{pseudo}   réservation d'un pseudo (en minuscules) : { uid }
//                    → garantit l'unicité, insensible à la casse
// scores/{uid_mode}  meilleur score d'un joueur dans un mode
//
// CANAL DES PILOTES (chat communautaire)
// messages/{id}            messages du canal (joueurs, système, ORION)
// chatState/{uid}          état anti-spam privé de chaque pilote
// presence/{uid}           dernier signe de vie dans le canal (pilotes connectés)
// reports/{msgId_uid}      signalements (un seul par message et par joueur)
// moderation/{id}          journal de modération (masquages automatiques, actions)
// moderators/{uid}         modérateurs (créés depuis la console Firebase)
// bans/{uid}               pilotes exclus du canal
// orion*/                  données du pilote IA ORION (serveur uniquement)
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function pseudoPath(name) {
      return /databases/$(database)/documents/pseudos/$(name);
    }

    // Pseudo : 3 à 15 caractères, lettres non accentuées, chiffres, _ et - uniquement
    function validPseudo(p) {
      return p is string && p.matches('^[A-Za-z0-9_-]{3,15}$');
    }

    function validMode(m) {
      return m in ['beginner', 'intermediate', 'pro'];
    }

    // ---------- Profils ----------
    function validUser(d, uid) {
      return d.keys().hasOnly(['uid', 'pseudo', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['uid', 'pseudo', 'createdAt', 'updatedAt'])
        && d.uid == uid
        && validPseudo(d.pseudo)
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      // Chaque joueur ne lit que son propre profil (le pseudo public est dans "scores")
      allow get: if isOwner(uid);
      allow list: if false;

      // Création : son propre UID uniquement, et le pseudo doit être réservé
      // à son nom dans la même transaction (pseudos/{pseudo en minuscules})
      allow create: if isOwner(uid)
        && validUser(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && getAfter(pseudoPath(request.resource.data.pseudo.lower())).data.uid == uid;

      // Modification du pseudo : même contrôle, ancien pseudo libéré dans la
      // même transaction, 10 s minimum entre deux changements (anti-spam)
      allow update: if isOwner(uid)
        && validUser(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.pseudo != resource.data.pseudo
        && request.time > resource.data.updatedAt + duration.value(10, 's')
        && getAfter(pseudoPath(request.resource.data.pseudo.lower())).data.uid == uid
        && (request.resource.data.pseudo.lower() == resource.data.pseudo.lower()
            || !existsAfter(pseudoPath(resource.data.pseudo.lower())));

      allow delete: if false;
    }

    // ---------- Réservations de pseudo (unicité) ----------
    match /pseudos/{name} {
      // Lecture publique d'un pseudo précis : vérifier s'il est libre
      allow get: if true;
      allow list: if false;

      // Réserver : uniquement pour soi, uniquement le pseudo de son profil (même transaction)
      // Un pseudo déjà pris ne peut pas être "créé" à nouveau (ce serait une mise à jour → refusée)
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_-]{3,15}$')
        && getAfter(userPath(request.auth.uid)).data.pseudo.lower() == name;

      // Libérer : uniquement son propre pseudo, et seulement en le remplaçant
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.pseudo.lower() != name;

      allow update: if false;
    }

    // ---------- Scores ----------
    // Le pseudo d'un score doit être exactement celui du profil du joueur
    function validScore(d) {
      return d.keys().hasOnly(['uid', 'pseudo', 'score', 'mode', 'bitcoins', 'distance', 'level', 'createdAt', 'v'])
        && d.keys().hasAll(['uid', 'pseudo', 'score', 'mode', 'bitcoins', 'distance', 'level', 'createdAt', 'v'])
        // Échelle des scores v2 (Débutant ×0,3, Pro ×5) : les anciennes versions du jeu sont refusées
        && d.v == 2
        && d.uid == request.auth.uid
        && validMode(d.mode)
        && validPseudo(d.pseudo)
        && d.pseudo == get(userPath(request.auth.uid)).data.pseudo
        && d.score is int    && d.score > 0     && d.score <= 10000000
        && d.bitcoins is int && d.bitcoins >= 0 && d.bitcoins <= 100000
        && d.distance is int && d.distance >= 0 && d.distance <= 10000000
        && d.level is int    && d.level >= 1    && d.level <= 100000
        // Plausibilité : le score ne peut pas dépasser ce que la distance
        // et les Bitcoins permettent d'obtenir (multiplicateur max ×5)
        && d.score <= 5 * (d.distance * 2 + d.bitcoins * 40) + 100
        && d.createdAt == request.time;
    }

    match /scores/{scoreId} {
      allow get: if true;

      // Requêtes de liste : limite obligatoire (top 10 = 10, rang = 1000)
      allow list: if request.query.limit <= 1000;

      // Création : uniquement SON document, identifiant imposé "{uid}_{mode}"
      allow create: if signedIn()
        && scoreId == request.auth.uid + '_' + request.resource.data.mode
        && validScore(request.resource.data);

      // Mise à jour par son propriétaire uniquement, mode inchangé, et :
      //  - soit un score STRICTEMENT supérieur, 10 s minimum après le précédent
      //  - soit la propagation d'un nouveau pseudo (score et stats intacts)
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && scoreId == request.auth.uid + '_' + resource.data.mode
        && request.resource.data.mode == resource.data.mode
        && validScore(request.resource.data)
        && (
          (request.resource.data.score > resource.data.score
            && request.time > resource.data.createdAt + duration.value(10, 's'))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pseudo', 'createdAt'])
            && request.resource.data.pseudo != resource.data.pseudo)
        );

      allow delete: if false;
    }

    // =====================================================
    // CANAL DES PILOTES
    // =====================================================
    function statePath(uid) {
      return /databases/$(database)/documents/chatState/$(uid);
    }
    function msgPath(id) {
      return /databases/$(database)/documents/messages/$(id);
    }
    function reportPath(id) {
      return /databases/$(database)/documents/reports/$(id);
    }
    function isModerator() {
      return signedIn() && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }
    function notBanned() {
      return !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }
    function myPseudo() {
      return get(userPath(request.auth.uid)).data.pseudo;
    }

    // Texte d'un message : 1 à 280 caractères, pas que des espaces, aucun caractère
    // de contrôle, aucun lien, aucun mot interdit (liste identique à js/chat-filter.js)
    function validText(t) {
      return t is string
        && t.size() >= 1 && t.size() <= 280
        && t.matches('(?s).*[^\\s].*')
        && !t.matches('(?s).*[\\x00-\\x1f\\x7f].*')
        && !t.lower().matches('(?s).*(https?://|www\\.|discord\\.gg|bit\\.ly|t\\.me/|\\.(com|net|org|io|gg|xyz|ru|tk|ly)/).*')
        && !t.lower().matches('(?s).*\\b(connard|connards|connasse|salope|salopes|pute|putes|encule|enculé|enculer|ntm|nique ta|niquer ta|fdp|fils de pute|batard|bâtard|pédé|pd|tapette|negro|négro|bougnoul|youpin|bicot|sale noir|sale arabe|sale juif|heil hitler|suce ma|suce moi)\\b.*');
    }

    // ---------- État anti-spam (privé) ----------
    // lastMsgAt  : dernier message (délai de 4 s entre deux messages)
    // winStart / winCount : fenêtre glissante de 60 s, 6 messages maximum
    // joinedAt / leftAt   : messages « rejoint / quitte » (1 par tranche de 10 min)
    // recordAt   : annonce de record (1 par tranche de 10 min)
    // welcomedAt : « Bienvenue à bord » (une seule fois, à la création)
    function validState(d) {
      return d.keys().hasOnly(['uid', 'createdAt', 'welcomedAt', 'lastMsgAt', 'lastMsgId', 'winStart', 'winCount', 'joinedAt', 'leftAt', 'recordAt'])
        && d.keys().hasAll(['uid', 'createdAt', 'welcomedAt', 'lastMsgAt', 'lastMsgId', 'winStart', 'winCount', 'joinedAt', 'leftAt', 'recordAt'])
        && d.uid == request.auth.uid
        && d.createdAt is timestamp && d.welcomedAt is timestamp
        && d.lastMsgAt is timestamp && d.lastMsgAt <= request.time
        && d.lastMsgId is string && d.lastMsgId.size() <= 40
        && d.winStart is timestamp && d.winStart <= request.time
        && d.winCount is int && d.winCount >= 0 && d.winCount <= 6
        && d.joinedAt is timestamp && d.joinedAt <= request.time
        && d.leftAt is timestamp && d.leftAt <= request.time
        && d.recordAt is timestamp && d.recordAt <= request.time;
    }
    function same(n, o, k) { return n[k] == o[k]; }

    match /chatState/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      // Création : au premier passage dans le canal, avec le message « Bienvenue à bord »
      allow create: if isOwner(uid) && notBanned()
        && validState(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.welcomedAt == request.time
        && request.resource.data.winCount == 0;

      // Mise à jour : chaque compteur ne peut évoluer que selon sa règle
      allow update: if isOwner(uid)
        && validState(request.resource.data)
        && same(request.resource.data, resource.data, 'createdAt')
        && same(request.resource.data, resource.data, 'welcomedAt')
        // délai de 4 s entre deux messages
        && (same(request.resource.data, resource.data, 'lastMsgAt')
            || (request.resource.data.lastMsgAt == request.time
                && request.time > resource.data.lastMsgAt + duration.value(4, 's')))
        // fenêtre de 60 s : +1 dans la fenêtre (6 maximum), ou nouvelle fenêtre
        && ((same(request.resource.data, resource.data, 'winStart') && same(request.resource.data, resource.data, 'winCount'))
            || (request.time < resource.data.winStart + duration.value(60, 's')
                && same(request.resource.data, resource.data, 'winStart')
                && request.resource.data.winCount == resource.data.winCount + 1)
            || (request.time >= resource.data.winStart + duration.value(60, 's')
                && request.resource.data.winStart == request.time
                && request.resource.data.winCount == 1))
        // « a rejoint le canal » : au plus une fois toutes les 10 min
        && (same(request.resource.data, resource.data, 'joinedAt')
            || (request.resource.data.joinedAt == request.time
                && request.time > resource.data.joinedAt + duration.value(10, 'm')))
        // « a quitté le canal » : une seule fois après chaque arrivée
        && (same(request.resource.data, resource.data, 'leftAt')
            || (request.resource.data.leftAt == request.time
                && resource.data.leftAt < resource.data.joinedAt))
        // annonce de record : au plus une fois toutes les 10 min
        && (same(request.resource.data, resource.data, 'recordAt')
            || (request.resource.data.recordAt == request.time
                && request.time > resource.data.recordAt + duration.value(10, 'm')));

      allow delete: if false;
    }

    // ---------- Messages ----------
    function baseMsg(d) {
      return d.uid == request.auth.uid
        && d.pseudo == myPseudo()
        && d.createdAt == request.time
        && d.hidden == false
        && d.reports == 0;
    }
    // L'état anti-spam a bien été mis à jour dans la même écriture groupée
    function stateMoved(field) {
      return getAfter(statePath(request.auth.uid)).data[field] == request.time
        && get(statePath(request.auth.uid)).data[field] != request.time;
    }
    function userMsg(d, id) {
      return d.keys().hasOnly(['uid', 'pseudo', 'type', 'text', 'createdAt', 'hidden', 'reports'])
        && d.keys().hasAll(['uid', 'pseudo', 'type', 'text', 'createdAt', 'hidden', 'reports'])
        && validText(d.text)
        && stateMoved('lastMsgAt')
        && getAfter(statePath(request.auth.uid)).data.lastMsgId == id
        && (getAfter(statePath(request.auth.uid)).data.winCount != get(statePath(request.auth.uid)).data.winCount
            || getAfter(statePath(request.auth.uid)).data.winStart != get(statePath(request.auth.uid)).data.winStart);
    }
    function sysKeys(d) {
      return d.keys().hasOnly(['uid', 'pseudo', 'type', 'createdAt', 'hidden', 'reports'])
        && d.keys().hasAll(['uid', 'pseudo', 'type', 'createdAt', 'hidden', 'reports']);
    }
    function scorePath(mode) {
      return /databases/$(database)/documents/scores/$(request.auth.uid + '_' + mode);
    }
    function recordMsg(d) {
      return d.keys().hasOnly(['uid', 'pseudo', 'type', 'mode', 'score', 'createdAt', 'hidden', 'reports'])
        && d.keys().hasAll(['uid', 'pseudo', 'type', 'mode', 'score', 'createdAt', 'hidden', 'reports'])
        && validMode(d.mode)
        && d.score is int
        // le record annoncé est exactement le record enregistré il y a moins de 5 min
        && get(scorePath(d.mode)).data.score == d.score
        && get(scorePath(d.mode)).data.createdAt > request.time - duration.value(5, 'm')
        && stateMoved('recordAt');
    }

    match /messages/{msgId} {
      // Lecture : messages visibles uniquement (les modérateurs voient tout)
      allow get: if resource.data.hidden == false || isModerator();
      allow list: if request.query.limit <= 50 && (resource.data.hidden == false || isModerator());

      allow create: if signedIn() && notBanned()
        && msgId.size() <= 40
        && baseMsg(request.resource.data)
        && (
          (request.resource.data.type == 'user' && userMsg(request.resource.data, msgId))
          // « Bienvenue à bord » : une seule fois, à la création de l'état anti-spam
          || (request.resource.data.type == 'welcome' && sysKeys(request.resource.data)
              && !exists(statePath(request.auth.uid))
              && getAfter(statePath(request.auth.uid)).data.welcomedAt == request.time)
          || (request.resource.data.type == 'join' && sysKeys(request.resource.data) && stateMoved('joinedAt'))
          || (request.resource.data.type == 'leave' && sysKeys(request.resource.data) && stateMoved('leftAt'))
          || (request.resource.data.type == 'record' && recordMsg(request.resource.data))
        );
      // Les messages d'ORION (type « orion ») sont écrits uniquement par le serveur.

      allow update: if signedIn() && (
        // L'auteur corrige son texte pendant 10 min
        (resource.data.uid == request.auth.uid
          && resource.data.type == 'user'
          && resource.data.hidden == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && validText(request.resource.data.text)
          && request.resource.data.editedAt == request.time
          && request.time < resource.data.createdAt + duration.value(10, 'm'))
        // Un autre pilote signale : +1, masqué automatiquement à 3 signalements
        || (resource.data.uid != request.auth.uid
          && resource.data.hidden == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports', 'hidden'])
          && request.resource.data.reports == resource.data.reports + 1
          && request.resource.data.hidden == (request.resource.data.reports >= 3)
          && existsAfter(reportPath(msgId + '_' + request.auth.uid))
          && !exists(reportPath(msgId + '_' + request.auth.uid)))
        // Modérateur : masquer ou réafficher
        || (isModerator()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'moderatedBy', 'moderatedAt'])
          && request.resource.data.hidden is bool
          && request.resource.data.moderatedBy == request.auth.uid
          && request.resource.data.moderatedAt == request.time)
      );

      // Suppression : l'auteur (ses messages écrits), ou un modérateur
      allow delete: if signedIn()
        && ((resource.data.uid == request.auth.uid && resource.data.type == 'user') || isModerator());
    }

    // ---------- Signalements ----------
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['messageId', 'reporterUid', 'authorUid', 'reason', 'createdAt'])
        && request.resource.data.keys().hasAll(['messageId', 'reporterUid', 'authorUid', 'reason', 'createdAt'])
        && reportId == request.resource.data.messageId + '_' + request.auth.uid
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['insulte', 'spam', 'haine', 'triche', 'autre']
        && request.resource.data.createdAt == request.time
        && request.resource.data.authorUid == get(msgPath(request.resource.data.messageId)).data.uid
        && request.resource.data.authorUid != request.auth.uid
        && getAfter(msgPath(request.resource.data.messageId)).data.reports
           == get(msgPath(request.resource.data.messageId)).data.reports + 1;
      allow update: if false;
      allow delete: if isModerator();
    }

    // ---------- Journal de modération ----------
    match /moderation/{logId} {
      allow read: if isModerator();
      // Masquage automatique : journalisé par le 3e signalement, dans la même écriture
      allow create: if signedIn()
        && logId == 'autohide_' + request.resource.data.messageId
        && request.resource.data.keys().hasOnly(['action', 'messageId', 'reports', 'by', 'createdAt'])
        && request.resource.data.keys().hasAll(['action', 'messageId', 'reports', 'by', 'createdAt'])
        && request.resource.data.action == 'auto_hide'
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(msgPath(request.resource.data.messageId)).data.hidden == true
        && get(msgPath(request.resource.data.messageId)).data.hidden == false
        && request.resource.data.reports == getAfter(msgPath(request.resource.data.messageId)).data.reports
        // Action manuelle d'un modérateur
        || (isModerator()
          && request.resource.data.keys().hasOnly(['action', 'messageId', 'targetUid', 'reason', 'by', 'createdAt'])
          && request.resource.data.action in ['hide', 'unhide', 'delete', 'ban', 'unban']
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time);
      allow update, delete: if false;
    }

    // ---------- Modérateurs et exclusions (gérés depuis la console ou par un modérateur) ----------
    match /moderators/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }
    match /bans/{uid} {
      allow get: if isOwner(uid) || isModerator();
      allow list: if isModerator() && request.query.limit <= 100;
      allow create: if isModerator()
        && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'reason', 'by', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/moderators/$(uid));
      allow delete: if isModerator();
      allow update: if false;
    }

    // ---------- Présence (pilotes connectés au canal) ----------
    match /presence/{uid} {
      allow get: if true;
      // Comptage et liste des pilotes présents : limite obligatoire
      allow list: if request.query.limit <= 1000;
      allow create: if isOwner(uid) && notBanned()
        && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'lastSeen'])
        && request.resource.data.keys().hasAll(['uid', 'pseudo', 'lastSeen'])
        && request.resource.data.uid == uid
        && request.resource.data.pseudo == myPseudo()
        && request.resource.data.lastSeen == request.time;
      // Signal de vie : au plus toutes les 30 s
      allow update: if isOwner(uid) && notBanned()
        && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'lastSeen'])
        && request.resource.data.uid == uid
        && request.resource.data.pseudo == myPseudo()
        && request.resource.data.lastSeen == request.time
        && request.time > resource.data.lastSeen + duration.value(30, 's');
      allow delete: if isOwner(uid);
    }

    // Tout le reste de la base est fermé (orion, orionLimits… : serveur uniquement)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
